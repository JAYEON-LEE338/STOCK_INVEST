# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 절대 공유/커밋 금지)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678-01

# mock(모의투자) / live(실전). 키 종류(모의/실전)와 일치해야 합니다.
MODE=mock
# 대시보드에서 모의/실전을 전환하려면 모드별 키를 따로 넣으세요 (없으면 위 KIS_* 는 MODE 와 같은 모드에만 쓰임)
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=

# 대시보드/예산 계산에서 숨길 보유 종목 (상장폐지 등, 종목명 일부 또는 코드, 콤마 구분)
HIDDEN_HOLDINGS=파나케이아

# true 면 주문을 보내지 않고 로그만 남깁니다
DRY_RUN=true

# KODEX 200 커버드콜 액티브 종목코드
COVERED_CALL_CODE=0219E0

# NXT(넥스트레이드) 매도용 시세 시장코드, 주문 거래소 코드 (KIS 문서로 확인)
NXT_PRICE_MARKET=NX
NXT_ORDER_EXCHANGE=NXT

# 안전장치 (원)
# 대시보드 외부 접속 (Tailscale). 127.0.0.1 외 주소를 쓰려면 비밀번호가 필수입니다.
DASHBOARD_PASSWORD=
DASHBOARD_HOSTS=127.0.0.1

# 텔레그램 알림 (telegram_setup.py 참고)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 계좌 규모에 맞게 조정 (예: 1회 = 계좌의 30%, 일일 = 계좌의 60% 안팎)
MAX_ORDER_AMOUNT=300000
MAX_DAILY_AMOUNT=600000
